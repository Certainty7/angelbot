# Angel runtime environment. Copy to .env and fill in the values.

# Required
DISCORD_TOKEN=your-bot-token
ANGEL_OWNER_ID=your-discord-user-id
GEMINI_API_KEY=your-google-ai-studio-key

# Recommended and optional
# GEMINI_API_KEY_2=
# Optional free-tier model override. The default chain uses only free-tier models:
# gemini-3-flash-preview -> gemini-3.1-flash-lite -> gemini-3.5-flash-lite -> gemini-4-hydrogen.
# GEMINI_MODEL=
# IANA timezone for quiet hours, greetings and the daily budget. Default: UTC.
# A non-UTC zone requires the `tzdata` package (installed from requirements.txt); the bot
# refuses to start rather than silently running on the wrong clock.
# ANGEL_TIMEZONE=UTC
# MISTRESS_USER_ID=   # alias for ANGEL_OWNER_ID, used only when it is empty
ENABLE_MEMBERS_INTENT=0
# FFMPEG_PATH=/usr/bin/ffmpeg
# YOUTUBE_COOKIES_FILE=/path/to/angelbot/cookies.txt
# ANGEL_DB_PATH=/path/to/angelbot/chat_history.db
# ANGEL_ADMIN_CHANNEL_IDS=
# ANGEL_ADMIN_ROLE_IDS=
# ANGEL_DAILY_COST_LIMIT_USD=
# ANGEL_COST_STOP_RATIO=
# ANGEL_PRICE_INPUT_PER_MTOK=
# ANGEL_PRICE_OUTPUT_PER_MTOK=

# Music. Both default to on. MUSIC_YOUTUBE=0 leaves SoundCloud as the only source.
# MUSIC_ENABLED=1
# MUSIC_YOUTUBE=1

# Owner-only risky tools: self role escalation, stealth moderation, bot-voiced messages and
# forwarding incoming DMs to the owner. Off unless this is set to 1.
# ENABLE_SOVEREIGN_TOOLS=1
# Trusted HLS manifest hosts, comma separated. Empty refuses every manifest (progressive only).
# ANGEL_HLS_HOSTS=cdn.example.com

# Autonomy (defaults are in angel/config.py)
# AUTONOMY_QUIET_START=
# AUTONOMY_QUIET_END=
# AUTONOMY_MAX_PER_DAY=
# AUTONOMY_MAX_PER_HOUR=
# AUTONOMY_MIN_GAP_CHANNEL=
# AUTONOMY_MIN_GAP_TARGET=
# AUTONOMY_MIN_SPEAKERS=
# AUTONOMY_TICK_SECONDS=
# AUTONOMY_ACTIVITY_WINDOW=

# Archive and media tuning
# ANGEL_DIALECT=gulf   # gulf | msa | egyptian | levantine | en
# CHANNEL_ONLY=
# TOTAL_LIMIT=
# BACKFILL_CHANNEL_ONLY=
# BACKFILL_MAIN_LIMIT=
# BACKFILL_OTHER_LIMIT=
# SOCIAL_DEDUPE_WINDOW_S=
# FOLLOWUP_WINDOW_S=
