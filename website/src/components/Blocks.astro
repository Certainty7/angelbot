---
import PipelineDiagram from './PipelineDiagram.astro';
import type { Block } from '../i18n/content';
import type { Lang } from '../i18n/ui';
import { inline } from '../lib/inline';
import CommandExplorer from './CommandExplorer.astro';
import PermissionTable from './PermissionTable.astro';
import ChangelogList from './ChangelogList.astro';
import FaqList from './FaqList.astro';
import CtaBand from './CtaBand.astro';

interface Props {
  blocks: Block[];
  lang: Lang;
}

const { blocks, lang } = Astro.props;

/** Internal links are authored once, in Arabic form; the English mirror prefixes /en. */
const localHref = (value: string): string =>
  value.startsWith('/') && lang === 'en' ? `/en${value}` : value;
---
{blocks.map((block) => {
  switch (block.kind) {
    case 'heading':
      return (
        <h2 class="block-heading" id={block.id}>
          <span class="block-heading__text">{block.text[lang]}</span>
        </h2>
      );
    case 'text':
      return <p class="prose" set:html={inline(block.text[lang])} />;
    case 'bullets':
      return (
        <ul class="bullets" role="list" data-reveal>
          {block.items.map((item) => (
            <li set:html={inline(item[lang])} />
          ))}
        </ul>
      );
    case 'entries':
      return (
        <ul class="rows" role="list" data-reveal>
          {block.items.map((item) => (
            <li class="row">
              <h2 class="row__title">{item.title[lang]}</h2>
              <p class="row__body" set:html={inline(item.body[lang])} />
              {item.meta && <p class="row__meta">{item.meta[lang]}</p>}
            </li>
          ))}
        </ul>
      );
    case 'steps':
      return (
        <ol class="steps" data-reveal>
          {block.items.map((item) => (
            <li class="step">
              <h2 class="step__title">{item.title[lang]}</h2>
              <p class="step__body" set:html={inline(item.body[lang])} />
            </li>
          ))}
        </ol>
      );
    case 'note':
      return (
        <aside class="note">
          <p set:html={inline(block.text[lang])} />
        </aside>
      );
    case 'link':
      return (
        <p class="block-link">
          <a class="text-link" href={localHref(block.href)}>{block.label[lang]}</a>
        </p>
      );
    case 'diagram':
      return <PipelineDiagram lang={lang} label={block.label[lang]} />;
    case 'commands':
      return <CommandExplorer lang={lang} />;
    case 'permissions':
      return <PermissionTable lang={lang} />;
    case 'changelog':
      return <ChangelogList />;
    case 'faq':
      return <FaqList lang={lang} items={block.items} />;
    case 'cta':
      return <CtaBand lang={lang} />;
    default:
      return null;
  }
})}
