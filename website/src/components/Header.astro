---
import { nav, ui, href, site, type Lang } from '../i18n/ui';
import invite from '../data/invite.json';
import lockupAr from '../assets/brand/angel-lockup-ar.svg?url&no-inline';
import lockupArDark from '../assets/brand/angel-lockup-ar-dark.svg?url&no-inline';
import lockupEn from '../assets/brand/angel-lockup-en.svg?url&no-inline';
import lockupEnDark from '../assets/brand/angel-lockup-en-dark.svg?url&no-inline';

interface Props {
  lang: Lang;
  slug: string;
  /** Explicit target for the language switch; defaults to the same slug in the other locale. */
  switchTo?: string;
}

const { lang, slug, switchTo } = Astro.props;
const switchHref = switchTo ?? href(lang === 'ar' ? 'en' : 'ar', slug);
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const light = lang === 'ar' ? lockupAr : lockupEn;
const dark = lang === 'ar' ? lockupArDark : lockupEnDark;
---
<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href={href(lang)} aria-label={`${site.name[lang]} — ${ui.home[lang]}`}>
      <img class="brand__img brand__img--light" src={light} alt="" width="78" height="40" />
      <img class="brand__img brand__img--dark" src={dark} alt="" width="78" height="40" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      data-label-open={ui.openMenu[lang]}
      data-label-close={ui.closeMenu[lang]}
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden" data-menu-label>{ui.openMenu[lang]}</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label={ui.primaryNav[lang]} data-site-nav>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={href(lang, item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>
              {item.label[lang]}
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav__extra">
        <a class="btn btn--primary" href={invite.invite_url}>{ui.invite[lang]}</a>
        <a class="lang-switch" href={switchHref} hreflang={other} lang={other}>{ui.language[lang]}</a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--primary btn--sm" href={invite.invite_url}>{ui.inviteShort[lang]}</a>
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={`${ui.language[lang]} — ${ui.languageHint[lang]}`}>
        {ui.language[lang]}
      </a>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-label-dark={ui.themeToDark[lang]}
        data-label-light={ui.themeToLight[lang]}
        aria-label={ui.themeToDark[lang]}
      >
        <svg class="icon icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z" />
        </svg>
        <span class="visually-hidden" data-theme-label>{ui.theme[lang]}</span>
      </button>
    </div>
  </div>
</header>
