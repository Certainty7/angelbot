---
import Base from '../layouts/Base.astro';
import { href, ui } from '../i18n/ui';
---
<Base lang="ar" title="الصفحة غير موجودة — أنجل" description="الرابط المطلوب غير موجود على موقع أنجل." slug="404" noindex canonicalPath="/404" switchTo="/en/404/">
  <section class="not-found container">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">هذه الصفحة غير موجودة.</h1>
    <p class="not-found__body">
      الرابط الذي فتحته لم يعد موجودًا أو لم يكن موجودًا أصلًا. من هنا يمكنك العودة إلى البداية أو قراءة الأوامر.
    </p>
    <div class="not-found__actions">
      <a class="btn btn--primary" href={href('ar')}>{ui.home.ar}</a>
      <a class="btn btn--secondary" href={href('ar', 'commands')}>{ui.browse.ar}</a>
      <a class="btn btn--secondary" href={href('en')} lang="en" hreflang="en">English</a>
    </div>
  </section>
</Base>
